{
  "info": {
    "_postman_id": "9c2e4f71-5a3b-4d8c-8e21-7f6a1b3c5d02",
    "name": "Servicio Web de Autenticación (PHP)",
    "description": "Pruebas de la API REST de inicio de sesión (PHP 8 + PDO/mysqli + MySQL).\n\nAutores: Juan Luis Torres Leal y Angela María Constain Escobar.\n\nAntes de ejecutar: inicie Apache y MySQL en XAMPP (o php -S localhost:8080 enrutador.php) y verifique la variable `urlBase`.\nUse \"Run collection\" para ejecutar todas las pruebas automáticas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "urlBase", "value": "http://localhost/servicio-autenticacion/api", "type": "string" },
    { "key": "usuarioNuevo", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Estado del servicio",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{urlBase}}/estado.php", "host": ["{{urlBase}}"], "path": ["estado.php"] },
        "description": "Verifica que el servicio esté en línea y que la base de datos responda."
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 200', () => pm.response.to.have.status(200));",
          "pm.test('Base de datos conectada', () => pm.expect(pm.response.json().exito).to.eql(true));"
        ]}
      }]
    },
    {
      "name": "2. Iniciar sesión - credenciales correctas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"jtorres\",\n  \"contrasena\": \"Clave123*\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] },
        "description": "Debe responder 200 con el mensaje 'Autenticación satisfactoria'."
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const cuerpo = pm.response.json();",
          "pm.test('Código 200', () => pm.response.to.have.status(200));",
          "pm.test('Mensaje de autenticación satisfactoria', () => pm.expect(cuerpo.mensaje).to.eql('Autenticación satisfactoria'));",
          "pm.test('No expone hash ni sal', () => { pm.expect(cuerpo.datos).to.not.have.property('hashContrasena'); pm.expect(cuerpo.datos).to.not.have.property('salContrasena'); });"
        ]}
      }]
    },
    {
      "name": "3. Iniciar sesión - contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"jtorres\",\n  \"contrasena\": \"ClaveErrada\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] },
        "description": "Debe responder 401 con error en la autenticación."
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 401', () => pm.response.to.have.status(401));",
          "pm.test('Mensaje de error en la autenticación', () => pm.expect(pm.response.json().mensaje).to.include('Error en la autenticación'));"
        ]}
      }]
    },
    {
      "name": "4. Iniciar sesión - usuario inexistente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"usuario.fantasma\",\n  \"contrasena\": \"Clave123*\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 401', () => pm.response.to.have.status(401));",
          "pm.test('exito = false', () => pm.expect(pm.response.json().exito).to.eql(false));"
        ]}
      }]
    },
    {
      "name": "5. Iniciar sesión - campos vacíos",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"\",\n  \"contrasena\": \"\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 400', () => pm.response.to.have.status(400));"
        ]}
      }]
    },
    {
      "name": "6. Iniciar sesión - JSON mal formado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ usuario: jtorres " },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 400', () => pm.response.to.have.status(400));"
        ]}
      }]
    },
    {
      "name": "7. Iniciar sesión - método GET no permitido",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 405', () => pm.response.to.have.status(405));"
        ]}
      }]
    },
    {
      "name": "8. Registrar usuario nuevo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"{{usuarioNuevo}}\",\n  \"contrasena\": \"ClaveNueva2026\",\n  \"nombreCompleto\": \"Usuario de Prueba Postman\",\n  \"correoElectronico\": \"prueba@correo.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/registro.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "registro.php"] },
        "description": "Crea un usuario con nombre aleatorio para poder ejecutar la colección varias veces."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('usuarioNuevo', 'postman.' + Date.now());"
          ]}
        },
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": [
            "pm.test('Código 201', () => pm.response.to.have.status(201));"
          ]}
        }
      ]
    },
    {
      "name": "9. Iniciar sesión con el usuario registrado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"{{usuarioNuevo}}\",\n  \"contrasena\": \"ClaveNueva2026\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/iniciar-sesion.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "iniciar-sesion.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 200', () => pm.response.to.have.status(200));",
          "pm.test('Autenticación satisfactoria', () => pm.expect(pm.response.json().mensaje).to.eql('Autenticación satisfactoria'));"
        ]}
      }]
    },
    {
      "name": "10. Registrar usuario duplicado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"jtorres\",\n  \"contrasena\": \"OtraClave2026\",\n  \"nombreCompleto\": \"Duplicado\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{urlBase}}/autenticacion/registro.php", "host": ["{{urlBase}}"], "path": ["autenticacion", "registro.php"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 409', () => pm.response.to.have.status(409));"
        ]}
      }]
    }
  ]
}
